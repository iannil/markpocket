{
  "name": "markpocket",
  "version": "1.0.0-alpha.1",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @markpocket/web exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @markpocket/web exec drizzle-kit migrate",
    "db:studio": "pnpm --filter @markpocket/web exec drizzle-kit studio",
    "test": "vitest run",
    "prepare": "husky || true",
    "typecheck": "turbo run typecheck",
    "test:e2e-api": "node tests/run-api-tests.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.2",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "turbo": "^2.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.4"
  }
}
