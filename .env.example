# markpocket environment — copy to .env and fill in real values.

# Postgres connection for NON-Docker runs (dev.sh writes apps/web/.env
# automatically; plain `pnpm dev`/`pnpm db:migrate` read it too).
# NOTE: docker-compose does NOT read this variable — the web container's
# DATABASE_URL is assembled from POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://markpocket:markpocket_dev@localhost:7400/markpocket

# Session cookie signing key — REQUIRED in production, >= 32 random chars.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Independent webhook encryption key: exactly 32 random bytes in canonical base64.
# Generate separately: openssl rand -base64 32. Back up this key with the database.
# Missing/wrong keys disable sending and preserve queued events. After restoring
# the key, an owner must explicitly resume; a lost key requires secret rotation.
# Never reuse BETTER_AUTH_SECRET. Development has no background sender; to drain
# once intentionally: cd apps/web && pnpm exec tsx --env-file=.env scripts/webhooks-once.ts
WEBHOOK_ENCRYPTION_KEY=

# Public URL of this instance (used for auth callbacks/cookies).
BETTER_AUTH_URL=http://localhost:3000

# Postgres password for docker-compose (consumed by both services).
POSTGRES_PASSWORD=

# Registration gate: leave unset (or empty/0/false) to keep sign-up OPEN;
# set to 1 to lock the instance to existing accounts.
DISABLE_SIGNUP=

# Storage adapter plugin (from plugins.config.ts registry; default: local).
STORAGE_PROVIDER=local

# Where the local storage adapter writes uploaded files (local non-Docker dev
# only). Docker deployments: DO NOT SET — the image presets /app/data/uploads
# and docker-compose bind-mounts ./data there; a stray UPLOAD_DIR here would
# override the image value (compose env_file beats image ENV) and silently
# write uploads inside the container filesystem, losing them on rebuild.
# UPLOAD_DIR=./uploads

# Per-user total upload quota in MB (default 2048; 0 = unlimited). Counts the
# sum of attachment sizes already stored by the user plus the incoming file.
# UPLOAD_USER_QUOTA_MB=2048

# Per-user concurrent download limit for /api/files/:id (default 4; 0 =
# unlimited). In-process semaphore — per instance, resets on restart.
# DOWNLOAD_CONCURRENCY_LIMIT=4

# ── Dev-only knobs (dev.sh sets these; listed for reference) ──
# Web dev server port (dev.sh uses 7420; production defaults to 3000).
# Docker deployments: compose pins the container to PORT=3000 — a value here
# is ignored by compose; remap the host port in docker-compose.yml instead.
# PORT=7420
# Standalone realtime gateway port in dev (see dev.sh / dev:realtime).
# REALTIME_PORT=7419
# WebSocket URL the browser connects to (defaults to same-origin /realtime).
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:7419/realtime
# Bind address for the custom server (default 0.0.0.0).
# HOSTNAME=0.0.0.0
